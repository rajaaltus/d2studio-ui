{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "component-showcase",
  "type": "registry:component",
  "title": "Component Showcase",
  "author": "D2 Studio",
  "description": "Interactive component preview with code examples",
  "registryDependencies": [
    "button",
    "card",
    "avatar"
  ],
  "files": [
    {
      "path": "registry/new-york/component-showcase/component-showcase.tsx",
      "content": "\"use client\";\n\nimport { Button } from \"@/components/ui/button\";\nimport { Card } from \"@/components/ui/card\";\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\";\nimport { cn } from \"@/lib/utils\";\nimport { useState } from \"react\";\n\nexport function ComponentShowcase() {\n  const [activeTab, setActiveTab] = useState(0);\n\n  const showcaseItems = [\n    {\n      name: \"Buttons\",\n      code: `<Button variant=\"default\">\n  Default Button\n</Button>\n\n<Button variant=\"outline\">\n  Outline Button\n</Button>\n\n<Button variant=\"ghost\">\n  Ghost Button\n</Button>`,\n      preview: (\n        <div className=\"space-y-3\">\n          <Button>Default Button</Button>\n          <Button variant=\"outline\">Outline Button</Button>\n          <Button variant=\"ghost\">Ghost Button</Button>\n        </div>\n      )\n    },\n    {\n      name: \"Cards\",\n      code: `<Card className=\"p-6\">\n  <h3 className=\"font-medium mb-2\">\n    Card Title\n  </h3>\n  <p className=\"text-muted-foreground\">\n    Card content goes here.\n  </p>\n</Card>`,\n      preview: (\n        <Card className=\"p-6\">\n          <h3 className=\"font-medium mb-2\">Card Title</h3>\n          <p className=\"text-muted-foreground\">Card content goes here.</p>\n        </Card>\n      )\n    },\n    {\n      name: \"Avatars\",\n      code: `<Avatar>\n  <AvatarFallback>\n    JS\n  </AvatarFallback>\n</Avatar>\n\n<Avatar className=\"h-12 w-12\">\n  <AvatarFallback>\n    MD\n  </AvatarFallback>\n</Avatar>`,\n      preview: (\n        <div className=\"flex items-center gap-4\">\n          <Avatar>\n            <AvatarFallback>JS</AvatarFallback>\n          </Avatar>\n          <Avatar className=\"h-12 w-12\">\n            <AvatarFallback>MD</AvatarFallback>\n          </Avatar>\n        </div>\n      )\n    }\n  ];\n\n  return (\n    <section className=\"py-24 relative\">\n      <div className=\"container mx-auto px-4\">\n        <div className=\"max-w-6xl mx-auto\">\n\n          {/* Section Header */}\n          <div className=\"text-center space-y-4 mb-16\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 border border-border rounded-full text-xs bg-card\">\n              <span>Showcase</span>\n            </div>\n            <h2 className=\"text-3xl md:text-4xl font-bold\">\n              See Components in Action\n            </h2>\n            <p className=\"text-muted-foreground max-w-2xl mx-auto\">\n              Interactive preview of our component library. Click on any tab to see the component\n              code and live preview side by side.\n            </p>\n          </div>\n\n          {/* Component Showcase */}\n          <Card className=\"overflow-hidden p-0\">\n\n            {/* Tabs */}\n            <div className=\"border-b border-border\">\n              <div className=\"flex\">\n                {showcaseItems.map((item, index) => (\n                  <button\n                    key={index}\n                    onClick={() => setActiveTab(index)}\n                    className={cn(\n                      \"px-6 py-4 text-sm font-medium border-r border-border last:border-r-0 transition-colors\",\n                      activeTab === index\n                        ? \"bg-muted text-foreground\"\n                        : \"text-muted-foreground hover:text-foreground hover:bg-muted/50\"\n                    )}\n                  >\n                    {item.name}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Content */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-2\">\n\n              {/* Code Panel */}\n              <div className=\"p-6 border-r border-border lg:border-r lg:border-b-0 border-b\">\n                <div className=\"space-y-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <h3 className=\"text-sm font-medium\">Code</h3>\n                    <Button variant=\"ghost\" size=\"sm\" className=\"h-6 px-2 text-xs\">\n                      Copy\n                    </Button>\n                  </div>\n                  <div className=\"bg-muted/30 rounded-lg p-4 overflow-x-auto\">\n                    <pre className=\"text-sm\">\n                      <code>{showcaseItems[activeTab].code}</code>\n                    </pre>\n                  </div>\n                </div>\n              </div>\n\n              {/* Preview Panel */}\n              <div className=\"p-6\">\n                <div className=\"space-y-4\">\n                  <h3 className=\"text-sm font-medium\">Preview</h3>\n                  <div className=\"flex items-center justify-center min-h-[120px] border border-border rounded-lg bg-background/50\">\n                    {showcaseItems[activeTab].preview}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </Card>\n\n          {/* Stats Grid */}\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-6 mt-16\">\n            <StatCard number=\"50+\" label=\"Components\" />\n            <StatCard number=\"100%\" label=\"TypeScript\" />\n            <StatCard number=\"0\" label=\"Dependencies\" />\n            <StatCard number=\"∞\" label=\"Customizable\" />\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nfunction StatCard({ number, label }: { number: string; label: string }) {\n  return (\n    <Card className=\"p-6 text-center bg-card/30 border-border/50\">\n      <div className=\"text-2xl md:text-3xl font-bold mb-1\">{number}</div>\n      <div className=\"text-sm text-muted-foreground\">{label}</div>\n    </Card>\n  );\n}",
      "type": "registry:component"
    }
  ],
  "categories": [
    "marketing",
    "showcase"
  ]
}