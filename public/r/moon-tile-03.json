    {
      "path": "registry/default/components/moon-tile-03/moon-tile-03.css",
      "content": "/* The moon card, played twice. Prefixed `mt3-` and scoped to this block's own\n   classes, so dropping the file into a project touches nothing else.\n\n   Dark is the source drawing's night colours on a dark rim, with a black drop\n   shadow where the source's light grey one would glow on a dark page. Light is\n   the same scene by day: a periwinkle card and sky, white clouds stepping down\n   to lavender in the order the night ones step down, a deeper gold so the moon\n   holds against a light sky, weaker glows and a soft blue shade where the\n   night one is black, on the source's own light rim and grey shadow. The dark\n   test is Tailwind's own: inside `.dark` unless a nearer `.theme-light` pins\n   the subtree light. */\n\n.mt3-root {\n  --mt3-card-top: #dfe2ff;\n  --mt3-card-bottom: #aab0f2;\n  --mt3-sky: #c3caf7;\n  --mt3-line: #7c82ee;\n  --mt3-line-low: #6d73ea;\n  --mt3-gold: #ffd21f;\n  --mt3-gold-shade: #f5b800;\n  --mt3-violet: #7c80e0;\n  --mt3-puff: #fcfcfd;\n  --mt3-puff-shade: #e6e8fb;\n  --mt3-cloud-1: #fcfcfd;\n  --mt3-cloud-2: #f4f5ff;\n  --mt3-cloud-3: #e6e8fb;\n  --mt3-cloud-4: #d8dbf3;\n  --mt3-glow: #9aa6ff;\n  --mt3-glow-strength: 0.3;\n  --mt3-glow-plum: #4e045b;\n  --mt3-glow-deep: #040b4d;\n  --mt3-lift: #3d4190;\n  --mt3-lift-strength: 0.2;\n  --mt3-drop: #c1c1c1;\n  --mt3-drop-strength: 0.5;\n  --mt3-rim-top: #d8d8d8;\n  --mt3-rim-bottom: #c6c6c6;\n\n  /* One lap and how many a play runs. The component ends the play at the same\n     total, so change both together. */\n  --mt3-lap: 3000ms;\n  --mt3-laps: 2;\n  --mt3-ease-out: cubic-bezier(0.23, 1, 0.32, 1);\n  --mt3-ease-rise: cubic-bezier(0.32, 0.72, 0, 1);\n}\n\n.mt3-root:where(.dark, .dark *):not(:where(.theme-light, .theme-light *)) {\n  --mt3-card-top: #6063af;\n  --mt3-card-bottom: #110615;\n  --mt3-sky: #2e314d;\n  --mt3-line: #8c91ff;\n  --mt3-line-low: #6d73ff;\n  --mt3-gold: #ffe400;\n  --mt3-gold-shade: #fdca00;\n  --mt3-violet: #9292dd;\n  --mt3-puff: #ded1d1;\n  --mt3-puff-shade: #c7c7d4;\n  --mt3-cloud-1: #8080c1;\n  --mt3-cloud-2: #7070ab;\n  --mt3-cloud-3: #616196;\n  --mt3-cloud-4: #515181;\n  --mt3-glow: #6b5dea;\n  --mt3-glow-strength: 1;\n  --mt3-lift: #000000;\n  --mt3-lift-strength: 0.75;\n  --mt3-drop: #000000;\n  --mt3-drop-strength: 0.5;\n  --mt3-rim-top: #373535;\n  --mt3-rim-bottom: #141313;\n}\n\n.mt3-blend {\n  mix-blend-mode: plus-lighter;\n}\n\n.mt3-glow ellipse {\n  fill-opacity: var(--mt3-glow-strength);\n}\n\n.mt3-lift {\n  flood-color: var(--mt3-lift);\n  flood-opacity: var(--mt3-lift-strength);\n}\n\n.mt3-drop {\n  flood-color: var(--mt3-drop);\n  flood-opacity: var(--mt3-drop-strength);\n}\n\n/* Hidden until the first play, so the rise is the first time it is seen. */\n.mt3-root[data-waiting] .mt3-moon {\n  opacity: 0;\n}\n\n/* The moon rises from behind the clouds once, at the start of a play, on the\n   iOS drawer curve so it lifts without a jolt and settles slowly, faded in\n   over the first part of the climb so no hard edge shows at the cloud line. */\n.mt3-root[data-playing] .mt3-moon {\n  animation: mt3-rise 1600ms var(--mt3-ease-rise) both;\n}\n\n/* fill-box puts each origin at the shape's own centre instead of the viewBox\n   corner, so the sparkle swells in place. */\n.mt3-sparkle {\n  transform-box: fill-box;\n  transform-origin: center;\n}\n\n/* Every animation below hangs off `data-playing` and ends on its first frame,\n   so clearing the attribute after a play lands where the play left off. */\n\n/* The banks sway on one lap each, the back one less far and the other way, so\n   the nearer cloud reads as nearer. */\n.mt3-root[data-playing] .mt3-bank-front {\n  animation: mt3-sway-left var(--mt3-lap) ease-in-out var(--mt3-laps) both;\n}\n.mt3-root[data-playing] .mt3-bank-back {\n  animation: mt3-sway-right var(--mt3-lap) ease-in-out var(--mt3-laps) both;\n}\n.mt3-root[data-playing] .mt3-bank-low {\n  animation: mt3-settle var(--mt3-lap) ease-in-out var(--mt3-laps) both;\n}\n\n/* The cloud makes one crossing a play: it drifts left out past the card's\n   edge, then, out of sight behind the card's clip, jumps to beyond the right\n   edge and drifts back in to rest, so it reads as the next cloud arriving.\n   Leaving is on-screen movement, so a strong ease in out; arriving is an\n   entrance, so a strong ease out that settles it in place. */\n.mt3-root[data-playing] .mt3-puff {\n  animation: mt3-pass calc(var(--mt3-lap) * var(--mt3-laps)) linear both;\n}\n\n/* Two twinkles a lap: a quick dip, then a slower bloom back to full. */\n.mt3-root[data-playing] .mt3-sparkle {\n  animation: mt3-twinkle calc(var(--mt3-lap) / 2) ease-in-out\n    calc(var(--mt3-laps) * 2) both;\n}\n\n/* The two stars blink half a beat apart, staggered inside their keyframes\n   rather than by a delay, so both rest at full when the play ends. */\n.mt3-root[data-playing] .mt3-star-violet {\n  animation: mt3-blink-early calc(var(--mt3-lap) / 2) ease-in-out\n    calc(var(--mt3-laps) * 2) both;\n}\n.mt3-root[data-playing] .mt3-star-gold {\n  animation: mt3-blink-late calc(var(--mt3-lap) / 2) ease-in-out\n    calc(var(--mt3-laps) * 2) both;\n}\n\n.mt3-root[data-playing] .mt3-glow {\n  animation: mt3-breathe var(--mt3-lap) ease-in-out var(--mt3-laps) both;\n}\n\n.mt3-turn {\n  animation: mt3-turn 500ms var(--mt3-ease-out);\n}\n\n@keyframes mt3-rise {\n  from {\n    transform: translateY(16px);\n    opacity: 0;\n  }\n  45% {\n    opacity: 1;\n  }\n}\n\n@keyframes mt3-sway-left {\n  50% {\n    transform: translateX(-1.6px);\n  }\n}\n\n@keyframes mt3-sway-right {\n  50% {\n    transform: translateX(1px);\n  }\n}\n\n@keyframes mt3-settle {\n  50% {\n    transform: translateY(1px);\n  }\n}\n\n/* The cloud is about 35 wide at 1.25x; 58 clears the left edge and 70 starts\n   it clear of the right, rotation included. */\n@keyframes mt3-pass {\n  0% {\n    transform: translateX(0);\n    animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);\n  }\n  45% {\n    transform: translateX(-58px);\n  }\n  45.01% {\n    transform: translateX(70px);\n    animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);\n  }\n  100% {\n    transform: translateX(0);\n  }\n}\n\n@keyframes mt3-twinkle {\n  20% {\n    transform: scale(0.82);\n    opacity: 0.55;\n  }\n}\n\n@keyframes mt3-blink-early {\n  25% {\n    opacity: 0.4;\n  }\n  50% {\n    opacity: 1;\n  }\n}\n\n@keyframes mt3-blink-late {\n  50% {\n    opacity: 1;\n  }\n  75% {\n    opacity: 0.4;\n  }\n}\n\n@keyframes mt3-breathe {\n  50% {\n    opacity: 0.8;\n  }\n}\n\n@keyframes mt3-turn {\n  from {\n    transform: rotate(0);\n  }\n  to {\n    transform: rotate(-1turn);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .mt3-root[data-playing]\n    :is(\n      .mt3-moon,\n      .mt3-bank-front,\n      .mt3-bank-back,\n      .mt3-bank-low,\n      .mt3-puff,\n      .mt3-sparkle,\n      .mt3-star,\n      .mt3-glow\n    ),\n  .mt3-turn {\n    animation: none;\n  }\n\n  /* No play ever starts, so the moon must not wait for one. */\n  .mt3-root[data-waiting] .mt3-moon {\n    opacity: 1;\n  }\n}\n",
