      "path": "registry/default/components/ai-writing-assistance.tsx",
      "content": "\"use client\"\n\nimport { ArrowUp, Command } from \"lucide-react\"\nimport {\n    IconCircleCopyPlus,\n    IconCloudUpload,\n    IconFile,\n    IconGearKeyhole,\n    IconSparkle\n} from \"nucleo-glass\"\nimport * as React from \"react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport {\n    DropdownMenu,\n    DropdownMenuContent,\n    DropdownMenuItem,\n    DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\n\nexport default function AIWritingAssistance() {\n    const [content, setContent] = React.useState(\"\")\n    const [selectedAI, setSelectedAI] = React.useState(\"AI Assistant\")\n    const [selectedModel, setSelectedModel] = React.useState(\"Gemini Pro 3.1 (New)\")\n\n    const models = [\n        { name: \"Blog writing - Gemini Pro 3.1 (New)\", value: \"Gemini Pro 3.1 (New)\" },\n        { name: \"Code writing - Claude Opus (New)\", value: \"Claude Opus (New)\" },\n        { name: \"Chat gpt - 4.1 2B LLM\", value: \"GPT-4\" },\n    ]\n\n    const aiOptions = [\"AI Assistant\", \"AI Pro\", \"AI Blog\"]\n\n    return (\n        <div className=\"flex flex-col items-center justify-center min-h-screen bg-[#0C0B0B] p-4 font-sans\" style={{ fontFamily: '\"Inter\", sans-serif' }}>\n\n            {/* Top Header Section */}\n            <div className=\"flex flex-col items-center text-center gap-4 w-full mb-[60px]\">\n                <div className=\"flex items-center gap-3\">\n                    {/* Sparkle SVG matching the reference */}\n                    <IconSparkle className=\"size-[34px] opacity-90\" />\n                    <h1 className=\"text-[40px] font-medium tracking-tight bg-gradient-to-b from-[#E3E3E3] to-[#A3A3A3] bg-clip-text text-transparent pb-1 whitespace-nowrap\">\n                        AI writing Assistant\n                    </h1>\n                </div>\n                <p className=\"text-[#848484] text-[18px] font-normal leading-relaxed\">\n                    Transform your ideas into polish content with AI-powered writing tools.\n                </p>\n            </div>\n\n            {/* Main Outer Box - Exactly 766px wide matching SVG */}\n            <div className=\"w-full max-w-[766px] bg-[#202020] rounded-[32px] border border-[#343434] p-[8px] flex flex-col shadow-2xl relative\">\n\n                {/* Inner Content Area - 751px inner wrapper */}\n                <div className=\"w-full bg-[#161616] rounded-[24px] border border-[#373737] flex flex-col pt-8 px-8 pb-6 relative shadow-inner overflow-hidden\" style={{ minHeight: '270px', boxShadow: '0px 2px 2px 0px rgba(0, 0, 0, 0.12)' }}>\n\n                    {/* Background Radial Gradient */}\n                    <div\n                        className=\"absolute inset-0 pointer-events-none\"\n                        style={{ background: 'radial-gradient(ellipse 130% 130% at 15% 0%, rgba(186, 186, 186, 0.15) 0%, rgba(0, 0, 0, 0) 100%)' }}\n                    />\n\n                    <div className=\"relative z-10 flex flex-col h-full\">\n                        {/* Header text mapped directly from reference */}\n                        <div className=\"flex flex-col gap-1.5 mb-6\">\n                            <h2 className=\"text-white text-[22px] font-medium tracking-tight\">\n                                Structured Content Generator\n                            </h2>\n                            <p className=\"text-[#848484] text-[15px] font-normal\">\n                                Generate specific types of content with clear objectives and structured inputs\n                            </p>\n                        </div>\n\n                        {/* Interactive Text Area */}\n                        <div className=\"flex-grow flex flex-col bg-[#0C0B0B] rounded-[20px] border border-[#2A2A2A] p-5 focus-within:border-[#3A3A3A] transition-colors shadow-inner\">\n                            <textarea\n                                placeholder=\"Describe the content you want to generate...\"\n                                className=\"bg-transparent border-none focus:ring-0 text-white placeholder:text-[#333333] placeholder:font-normal resize-none w-full min-h-[60px] flex-grow text-[16px] leading-[1.6] outline-none\"\n                                value={content}\n                                onChange={(e) => setContent(e.target.value)}\n                            />\n\n                            {/* Control Bar inside the inner box bottom */}\n                            <div className=\"flex items-center justify-between mt-auto pt-4\">\n                                <div className=\"flex items-center gap-4\">\n                                    <DropdownMenu>\n                                        <DropdownMenuTrigger asChild>\n                                            <button className=\"hover:scale-110 transition-transform\">\n                                                <IconCircleCopyPlus className=\"size-[20px]\" />\n                                            </button>\n                                        </DropdownMenuTrigger>\n                                        <DropdownMenuContent className=\"bg-[#1A1A1A] border-[#343434] text-white\">\n                                            <DropdownMenuItem className=\"gap-2 cursor-pointer focus:bg-[#2A2A2A]\">\n                                                <IconCloudUpload className=\"size-4\" /> upload.md\n                                            </DropdownMenuItem>\n                                            <DropdownMenuItem className=\"gap-2 cursor-pointer focus:bg-[#2A2A2A]\">\n                                                <IconFile className=\"size-4\" /> docs\n                                            </DropdownMenuItem>\n                                        </DropdownMenuContent>\n                                    </DropdownMenu>\n\n                                    <DropdownMenu>\n                                        <DropdownMenuTrigger asChild>\n                                            <button className=\"hover:scale-110 transition-transform flex items-center justify-center\">\n                                                <IconGearKeyhole className=\"size-[20px]\" />\n                                            </button>\n                                        </DropdownMenuTrigger>\n                                        <DropdownMenuContent className=\"bg-[#1A1A1A] border-[#343434] text-white w-64\">\n                                            {models.map((m) => (\n                                                <DropdownMenuItem\n                                                    key={m.value}\n                                                    onClick={() => setSelectedModel(m.value)}\n                                                    className=\"cursor-pointer focus:bg-[#2A2A2A]\"\n                                                >\n                                                    {m.name}\n                                                </DropdownMenuItem>\n                                            ))}\n                                        </DropdownMenuContent>\n                                    </DropdownMenu>\n\n                                    <DropdownMenu>\n                                        <DropdownMenuTrigger asChild>\n                                            <button className=\"flex items-center justify-center gap-2 text-[#A78BFA] font-medium text-[14px] hover:opacity-80 transition-opacity ml-1\">\n                                                <svg\n                                                    width={16}\n                                                    height={16}\n                                                    viewBox=\"0 0 16 16\"\n                                                    fill=\"none\"\n                                                    xmlns=\"http://www.w3.org/2000/svg\"\n                                                >