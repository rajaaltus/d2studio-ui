{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ai-writing-assistance",
  "title": "AI Writing Assistant",
  "author": "D2 Studio",
  "description": "AI writing assistant panel with assistant, blog and pro modes and a prompt field.",
  "dependencies": [
