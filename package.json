{
  "name": "d2studio-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:local": "npm-run-all --parallel dev:frontend dev:backend:local",
    "dev:frontend": "next dev --port 4200",
    "dev:backend": "convex dev",
    "dev:backend:local": "convex dev --local",
    "build": "next build",
    "build:registry": "npx shadcn registry:build",
    "registry:sync": "node scripts/sync-registry.mjs",
    "registry:sync:check": "node scripts/sync-registry.mjs --dry-run",
    "registry:build": "node scripts/sync-registry.mjs && shadcn build",
    "registry:watch": "shadcn build --watch",
    "registry:validate": "shadcn validate",
    "registry:clean": "rm -rf public/r/*.json",
    "registry:publish": "pnpm registry:build && pnpm seed",
    "registry:publish:prod": "pnpm registry:build && pnpm seed:prod",
    "seed": "node scripts/seed-content.mjs",
    "seed:prod": "node scripts/seed-content.mjs --prod",
    "content:pull": "node scripts/pull-from-prod.mjs",
    "content:pull:check": "node scripts/pull-from-prod.mjs --dry-run",
    "content:pull:local": "node scripts/pull-from-prod.mjs --local --no-seed",
    "content:pull:local:check": "node scripts/pull-from-prod.mjs --local --dry-run",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.91",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shikijs/compat": "^2.5.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.35.1",
    "gifenc": "^1.0.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.544.0",
    "metal-fx": "^0.2.3",
    "motion": "^12.38.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "nucleo-glass": "^1.3.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.63.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.8.0",
    "shiki": "^3.12.2",
    "sonner": "^2.0.7",
    "svg-dotted-map": "^2.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/lets-icons": "^1.2.2",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "shadcn": "^3.3.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  }
}